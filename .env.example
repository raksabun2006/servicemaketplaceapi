# ==========================================
# Local Docker & Dev Configuration
# ==========================================
PORT=8080
POSTGRES_DB=service_marketplace
POSTGRES_USER=service_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5436

# ==========================================
# Railway / Production Environment Variables
# ==========================================
# In Railway, if you attach a Postgres service, Railway provides either:
# 1) DATABASE_URL (automatically converted to JDBC by entrypoint.sh)
# 2) Or PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD
#
# Custom application settings:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=service-platform

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend & CORS
FRONTEND_URL=https://servicemaketplacefront.vercel.app
CORS_ALLOWED_ORIGINS=https://servicemaketplacefront.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# Storage & Hibernate
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=/uploads
HIBERNATE_DDL_AUTO=update

# ==========================================
# Mail Configuration (Gmail SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PROVIDER=smtp
